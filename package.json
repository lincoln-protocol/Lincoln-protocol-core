{
  "name": "@lincolnprotocol/core",
  "version": "0.1.0-rc.3",
  "private": true,
  "description": "Lincoln privacy contracts, zero-knowledge circuits and verifiable public review sources.",
  "type": "module",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lincoln-protocol/Lincoln-protocol-core.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/review/run.mjs check",
    "build": "node scripts/review/run.mjs build",
    "check:circuits": "node scripts/review/run.mjs circuits",
    "check:abi": "node scripts/review/run.mjs abi",
    "test": "node scripts/review/run.mjs node",
    "test:contracts": "node scripts/review/run.mjs contracts",
    "test:foundry": "npm run test:contracts",
    "test:proofs": "node scripts/review/run.mjs proofs",
    "test:acceptance": "npm run test:proofs",
    "test:acceptance:native": "node test/proofs/native.mjs",
    "test:acceptance:fees": "node test/proofs/fees.mjs",
    "test:all": "npm run check && npm run check:abi && npm run build && npm run check:circuits && npm test && npm run test:contracts && npm run test:contracts:deep && npm run test:proofs",
    "plan": "node scripts/review/run.mjs plan",
    "sync:review": "node scripts/review/layout.mjs",
    "check:review": "node scripts/review/layout.mjs --check",
    "test:contracts:deep": "node scripts/review/run.mjs contracts-deep"
  },
  "dependencies": {
    "@iden3/binfileutils": "0.0.12",
    "@openzeppelin/contracts": "5.0.2",
    "blake2b-wasm": "2.4.0",
    "circom2": "0.2.22",
    "circomlib": "2.0.5",
    "ethers": "6.17.0",
    "maci-crypto": "2.5.0",
    "poseidon-solidity": "0.0.5",
    "snarkjs": "0.7.5",
    "solc": "0.8.28",
    "viem": "2.22.14"
  }
}
